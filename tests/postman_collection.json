              "});",
              "pm.test(\"Resposta deve ser uma lista de planos\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.be.an(\"array\");",
              "    pm.expect(jsonData.length).to.be.above(0);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/planos",
          "host": ["{{baseUrl}}"],
          "path": ["api", "planos"]
        }
      }
    },
    {
      "name": "CT-API-05: Lançamento de Mensalidade / Pagamento",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code deve ser 201 Created\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "pm.test(\"Deve confirmar registro de pagamento com sucesso\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.sucesso).to.be.true;",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"idAluno\": 3,\n  \"valor\": 139.90,\n  \"status\": \"Pago\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/pagamentos",
          "host": ["{{baseUrl}}"],
          "path": ["api", "pagamentos"]
        }
      }
    },
    {
      "name": "CT-API-06: Consulta da Equipe de Instrutores",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code deve ser 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Retorna lista de instrutores registrados\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.be.an(\"array\");",
              "    pm.expect(jsonData.length).to.be.above(0);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
